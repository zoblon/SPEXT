    "Use AirPods automatically" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods automatisch verwenden"
          }
        }
      }
    },
    "With the automatic selection turned off, your microphone choice also applies when AirPods are connected. This lets you listen through the AirPods and dictate through the Mac's microphone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei ausgeschalteter Automatik gilt deine Mikrofonwahl auch mit verbundenen AirPods. So kannst du über die AirPods hören und über das Mac-Mikrofon diktieren."
