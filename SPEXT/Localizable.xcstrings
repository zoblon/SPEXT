        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachricht schreiben"
          }
        }
      }
    },
    "macOS requires your confirmation. SPEXT can request the entries and guide you to the right place, but cannot enable them without your approval." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
